#!/usr/bin/env python3
"""
FusionCompute VRM REST API smoke test.

Version: 1.3.0

Tests:
  1) Login (POST /service/session) — reports success/failure
  2) List sites (GET /service/sites)
  3) List all VMs across sites (GET /service/sites/{id}/vms) with pagination

Based on FusionCompute 8.8.1 VRM APIs (HTTPS, base path /service).

Port note (Huawei VRM APIs doc):
  - REST northbound API: typically TCP 7443
  - Web UI login page: typically TCP 8443
  If login returns HTTP 401 / errorCode 10000002 against :8443, retry with :7443.

Auth notes:
  - REST doc default X-Auth-UserType is 2 (interconnection / 接口对接用户).
  - Web UI domain/local accounts often work in the browser but fail REST with 10100103
    unless userType/authType/password encoding match, or an interconnection user is used.
  - Domain without cascading DC: userType=1, authType=0.
TLS verify is off (self-signed certificates).

Example (interactive prompts for URL, username, password):
  python3 vrm_api_test.py
  python3 vrm_api_test.py --diagnose
  python3 vrm_api_test.py --version
"""

from __future__ import annotations

import argparse
import getpass
import hashlib
import json
import os
import re
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field
from typing import Any
from urllib.parse import urlparse

__version__ = "1.3.0"
__api_doc__ = "FusionCompute 8.8.1 VRM APIs"

DEFAULT_PORT = 8443
REST_API_PORT = 7443  # documented VRM REST port
DEFAULT_API_VERSION = "8.1"
DEFAULT_USER_TYPE = 1  # domain user (prompt can override)
DEFAULT_AUTH_TYPE = 0  # local auth (VRM domain LDAP) — not cascading
PAGE_SIZE = 100
TOKEN_HEADER = "X-Auth-Token"

USER_TYPE_NAMES = {0: "local", 1: "domain", 2: "interconnection"}
AUTH_TYPE_NAMES = {0: "local", 1: "cascading-domain"}

# Doc: 401 / 10000002 = not logged in or session timed out
HINT_10000002 = """
Hints for HTTP 401 / errorCode 10000002
("not logged in or login timed out"):
  1) REST API port is usually 7443, while 8443 is often the Web UI.
     Try URL like: https://<vrm-ip>:7443
  2) For domain users without cascading DC, use:
       --user-type 1 --auth-type 0
  3) Username format: try DOMAIN\\\\user  or  user@domain.com  or  plain sAMAccountName
  4) Account must exist in FusionCompute with a role assigned (domain sync / mapped).
  5) Re-run with --diagnose to try common auth combinations.
""".strip()

# Doc: 400 / 10100119 = Cascade domain controller not configured
HINT_10100119 = """
Hints for errorCode 10100119
("Cascade domain controller not configured"):
  Your VRM has no cascading domain controller. Do NOT use AuthType=1.
  Use domain user + local authentication instead:
    --user-type 1 --auth-type 0
  Ensure a domain authentication server is configured under VRM user/domain settings,
  and your account is synced/assigned a role.
""".strip()

# Doc: 400 / 10100103 = username or password incorrect
HINT_10100103 = """
Hints for errorCode 10100103
("username or password is incorrect") — even when Web UI login works:

  Web UI (:8443) and REST API are different auth paths.

  1) Preferred for REST: create an "接口对接用户" / Interface interconnection user
     in FusionCompute (System Management → Permissions → Users).
     That account cannot log in to the Web UI, but is what northbound REST expects.
     Then run with:  --user-type 2 --auth-type 0
     (REST doc default userType is 2 / interconnection.)

  2) If you must use a domain account via REST:
       --user-type 1 --auth-type 0
     Username must match how the user is registered in FusionCompute
     (often plain sAMAccountName, not DOMAIN\\\\user). Try:
       - just the short name (user)
       - user@domain.com
       - DOMAIN\\\\user
     Re-run:  python3 vrm_api_test.py --diagnose --verbose

  3) Password must be SHA-256 hex of the plaintext (X-ENCRYPT-ALGORITHM=0),
     or plaintext with --encrypt-algorithm 1. --diagnose tries both / hex case.

  4) Confirm REST URL uses port 7443 (API), not only 8443 (Web UI).
""".strip()


@dataclass
class LoginResult:
    ok: bool
    token: str | None = None
    body: dict[str, Any] | None = None
    error: str | None = None
    error_code: str | None = None
    http_status: int | None = None
    user_type: int | None = None
    auth_type: int | None = None
    encrypt_algorithm: int | None = None
    attempted: list[str] = field(default_factory=list)


@dataclass
class VrmEndpoint:
    host: str
    port: int
    scheme: str = "https"

    @property
    def base(self) -> str:
        return f"{self.scheme}://{self.host}:{self.port}"

    @property
    def display(self) -> str:
        return self.base


def parse_vrm_url(raw: str, default_port: int = DEFAULT_PORT) -> VrmEndpoint:
    """
    Accepts:
      https://vrm.example.com:8443
      https://vrm.example.com
      vrm.example.com:8443
      vrm.example.com
      192.168.1.100
    """
    text = (raw or "").strip()
    if not text:
        raise ValueError("URL is empty")

    if "://" not in text:
        text = "https://" + text

    parsed = urlparse(text)
    if parsed.scheme not in ("https", "http"):
        raise ValueError(f"Unsupported URL scheme: {parsed.scheme!r} (use https)")
    if not parsed.hostname:
        raise ValueError(f"Could not parse host from URL: {raw!r}")

    port = parsed.port or default_port
    return VrmEndpoint(host=parsed.hostname, port=port, scheme=parsed.scheme)


class VrmClient:
    def __init__(
        self,
        endpoint: VrmEndpoint,
        api_version: str = DEFAULT_API_VERSION,
        verify_ssl: bool = False,
        timeout: float = 30.0,
    ) -> None:
        self.endpoint = endpoint
        self.base = endpoint.base
        self.api_version = api_version
        self.timeout = timeout
        self.token: str | None = None
        self._ssl_ctx = ssl.create_default_context()
        # Self-signed VRM certificates: skip verification unless explicitly enabled
        if not verify_ssl:
            self._ssl_ctx.check_hostname = False
            self._ssl_ctx.verify_mode = ssl.CERT_NONE

    def _headers(self, extra: dict[str, str] | None = None, auth: bool = True) -> dict[str, str]:
        headers = {
            "Accept": f"application/json;version={self.api_version};charset=UTF-8",
            "Content-Type": "application/json;charset=UTF-8",
            "Accept-Language": "en_US",
        }
        if auth and self.token:
            headers[TOKEN_HEADER] = self.token
        if extra:
            headers.update(extra)
        return headers

    def request(
        self,
        method: str,
        path: str,
        *,
        headers: dict[str, str] | None = None,
        body: dict[str, Any] | None = None,
        auth: bool = True,
    ) -> tuple[int, dict[str, str], Any]:
        url = self.base + path
        data = None if body is None else json.dumps(body).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers=self._headers(headers, auth=auth),
            method=method.upper(),
        )
        try:
            with urllib.request.urlopen(req, context=self._ssl_ctx, timeout=self.timeout) as resp:
                raw = resp.read()
                resp_headers = {k: v for k, v in resp.headers.items()}
                payload: Any = None
                if raw:
                    try:
                        payload = json.loads(raw.decode("utf-8"))
                    except json.JSONDecodeError:
                        payload = raw.decode("utf-8", errors="replace")
                return resp.status, resp_headers, payload
        except urllib.error.HTTPError as e:
            raw = e.read()
            payload = None
            if raw:
                try:
                    payload = json.loads(raw.decode("utf-8"))
                except json.JSONDecodeError:
                    payload = raw.decode("utf-8", errors="replace")
            headers_out = {k: v for k, v in e.headers.items()} if e.headers else {}
            return e.code, headers_out, payload
        except urllib.error.URLError as e:
            raise ConnectionError(f"Cannot reach VRM at {url}: {e.reason}") from e

    @staticmethod
    def hash_password(password: str, algorithm: int = 0, *, uppercase_hex: bool = False) -> str:
        """X-ENCRYPT-ALGORITHM: 0 = SHA-256 hex (default), 1 = plaintext."""
        if algorithm == 1:
            return password
        digest = hashlib.sha256(password.encode("utf-8")).hexdigest()
        return digest.upper() if uppercase_hex else digest

    @staticmethod
    def username_variants(username: str) -> list[str]:
        """Common FC username forms (Web UI vs REST often differ)."""
        raw = username.strip()
        variants = [raw]
        # DOMAIN\user or DOMAIN/user
        m = re.match(r"^([^\\/@]+)[\\/](.+)$", raw)
        if m:
            domain, user = m.group(1), m.group(2)
            variants.extend([user, f"{user}@{domain}", f"{domain}\\{user}"])
        # user@domain.com
        if "@" in raw and not m:
            user, domain = raw.split("@", 1)
            variants.extend([user, f"{domain}\\{user}", f"{domain.split('.')[0]}\\{user}"])
        # de-dupe, preserve order
        seen: set[str] = set()
        out: list[str] = []
        for v in variants:
            if v and v not in seen:
                seen.add(v)
                out.append(v)
        return out

    def login(
        self,
        username: str,
        password: str,
        *,
        user_type: int = DEFAULT_USER_TYPE,
        auth_type: int = DEFAULT_AUTH_TYPE,
        encrypt_algorithm: int = 0,
        uppercase_hex: bool = False,
        verbose: bool = False,
    ) -> LoginResult:
        """
        POST /service/session

        user_type: 0 local, 1 domain, 2 interconnection.
        auth_type: 0 local authentication, 1 cascading domain authentication.
        """
        hashed = self.hash_password(
            password, encrypt_algorithm, uppercase_hex=uppercase_hex
        )
        extra = {
            "X-Auth-User": username,
            "X-Auth-Key": hashed,
            "X-Auth-UserType": str(user_type),
            "X-Auth-AuthType": str(auth_type),
            "X-ENCRYPT-ALGORITHM": str(encrypt_algorithm),
        }
        hex_note = ""
        if encrypt_algorithm == 0:
            hex_note = f" sha256={'upper' if uppercase_hex else 'lower'}"
        label = (
            f"user={username!r} "
            f"userType={user_type}/{USER_TYPE_NAMES.get(user_type, '?')} "
            f"authType={auth_type}/{AUTH_TYPE_NAMES.get(auth_type, '?')} "
            f"encrypt={encrypt_algorithm}{hex_note}"
        )
        if verbose:
            safe = {k: ("***" if k == "X-Auth-Key" else v) for k, v in extra.items()}
            print(f"  POST {self.base}/service/session")
            print(f"  try: {label}")
            print(f"  headers: {safe}")

        status, headers, body = self.request(
            "POST",
            "/service/session",
            headers=extra,
            auth=False,
        )

        token = None
        for key, value in headers.items():
            if key.lower() == TOKEN_HEADER.lower():
                token = value
                break

        error_code = None
        err = None
        if isinstance(body, dict):
            error_code = str(body.get("errorCode")) if body.get("errorCode") is not None else None
            err = body.get("errorDes") or body.get("errorCode") or json.dumps(body)
        elif body is not None:
            err = str(body)
        else:
            err = f"HTTP {status}"

        if status == 200 and token:
            self.token = token
            return LoginResult(
                ok=True,
                token=token,
                body=body if isinstance(body, dict) else None,
                http_status=status,
                user_type=user_type,
                auth_type=auth_type,
                encrypt_algorithm=encrypt_algorithm,
                attempted=[label],
            )

        if verbose:
            print(f"  -> HTTP {status} body={body}")

        return LoginResult(
            ok=False,
            body=body if isinstance(body, dict) else None,
            error=err,
            error_code=error_code,
            http_status=status,
            user_type=user_type,
            auth_type=auth_type,
            encrypt_algorithm=encrypt_algorithm,
            attempted=[label],
        )

    def login_with_fallback(
        self,
        username: str,
        password: str,
        *,
        user_type: int,
        auth_type: int,
        encrypt_algorithm: int = 0,
        diagnose: bool = False,
        verbose: bool = False,
    ) -> LoginResult:
        """
        Try primary auth settings, then sensible fallbacks for 10100103/10100119.

        Attempt tuple: (username, user_type, auth_type, encrypt, uppercase_hex)
        """
        attempts: list[tuple[str, int, int, int, bool]] = [
            (username, user_type, auth_type, encrypt_algorithm, False)
        ]

        def add(u: str, ut: int, at: int, enc: int, upper: bool = False) -> None:
            item = (u, ut, at, enc, upper)
            if item not in attempts:
                attempts.append(item)

        # Cascade DC missing → retry domain + local auth
        if user_type == 1 and auth_type == 1:
            add(username, 1, 0, encrypt_algorithm, False)

        # Wrong password encoding is a common 10100103 cause — always try the other mode once
        if encrypt_algorithm == 0:
            add(username, user_type, auth_type if not (user_type == 1 and auth_type == 1) else 0, 0, True)
            add(username, user_type, 0 if user_type == 1 else auth_type, 1, False)
        else:
            add(username, user_type, auth_type, 0, False)

        if diagnose:
            names = self.username_variants(username)
            for name in names:
                # Domain via VRM LDAP
                add(name, 1, 0, 0, False)
                add(name, 1, 0, 0, True)
                add(name, 1, 0, 1, False)
                # Interconnection (REST default in Huawei docs)
                add(name, 2, 0, 0, False)
                add(name, 2, 0, 1, False)
                # Local
                add(name, 0, 0, 0, False)
                add(name, 0, 0, 1, False)

        attempted_labels: list[str] = []
        last = LoginResult(ok=False, error="no attempts")
        for name, ut, at, enc, upper in attempts:
            last = self.login(
                name,
                password,
                user_type=ut,
                auth_type=at,
                encrypt_algorithm=enc,
                uppercase_hex=upper,
                verbose=verbose,
            )
            attempted_labels.extend(last.attempted)
            if last.ok:
                last.attempted = attempted_labels
                return last
            # Stop early on lockouts
            if last.error_code in {"10100113", "10100116", "10100117", "10100118"}:
                break

        last.attempted = attempted_labels
        return last

    def logout(self) -> bool:
        if not self.token:
            return True
        status, _, _ = self.request("DELETE", "/service/session")
        self.token = None
        return status == 200

    def list_sites(self) -> list[dict[str, Any]]:
        status, _, body = self.request("GET", "/service/sites")
        if status != 200:
            raise RuntimeError(f"List sites failed (HTTP {status}): {body}")
        if not isinstance(body, dict):
            raise RuntimeError(f"Unexpected sites response: {body}")
        return body.get("sites") or []

    def list_vms_for_site(
        self,
        site_uri: str,
        *,
        include_templates: bool = False,
        detail: int = 0,
    ) -> list[dict[str, Any]]:
        """Paginate GET {site_uri}/vms until all VMs are collected."""
        all_vms: list[dict[str, Any]] = []
        offset = 0
        total: int | None = None

        while True:
            query = urllib.parse.urlencode(
                {
                    "limit": PAGE_SIZE,
                    "offset": offset,
                    "isTemplate": "true" if include_templates else "false",
                    "detail": detail,
                }
            )
            path = f"{site_uri}/vms?{query}"
            status, _, body = self.request("GET", path)
            if status != 200:
                raise RuntimeError(f"List VMs failed for {site_uri} (HTTP {status}): {body}")
            if not isinstance(body, dict):
                raise RuntimeError(f"Unexpected VMs response: {body}")

            batch = body.get("vms") or []
            total = int(body.get("total", len(batch)))
            all_vms.extend(batch)

            offset += len(batch)
            if not batch or offset >= total:
                break

        return all_vms


def _print_banner(title: str) -> None:
    print()
    print("=" * 60)
    print(title)
    print("=" * 60)


def _prompt(label: str, default: str | None = None) -> str:
    if default:
        value = input(f"{label} [{default}]: ").strip()
        return value or default
    while True:
        value = input(f"{label}: ").strip()
        if value:
            return value
        print("  (required)")


def prompt_credentials(args: argparse.Namespace) -> tuple[VrmEndpoint, str, str]:
    """Prompt for VRM URL, domain username, and password when not provided."""
    print(f"FusionCompute VRM API test  v{__version__}")
    print(f"API reference: {__api_doc__}")
    print(
        f"Defaults: port {DEFAULT_PORT} (REST often {REST_API_PORT}), "
        "self-signed TLS accepted"
    )
    print(
        "User types: 0=local, 1=domain (Web UI domain account), "
        "2=interconnection/接口对接 (recommended for REST)"
    )
    print()

    raw_url = args.url or os.environ.get("VRM_URL")
    if not raw_url:
        raw_url = _prompt(
            f"VRM URL (e.g. https://vrm.example.com:{REST_API_PORT})",
            default=None,
        )
    endpoint = parse_vrm_url(raw_url, default_port=args.port)

    # Allow interactive override of user type when not forced via CLI/env specialty
    if "VRM_USER_TYPE" not in os.environ and "--user-type" not in sys.argv:
        ut_raw = _prompt(
            "User type (0=local, 1=domain, 2=interconnection)",
            default=str(args.user_type),
        )
        try:
            args.user_type = int(ut_raw)
        except ValueError:
            raise SystemExit(f"Invalid user type: {ut_raw!r}")

    username = args.user or os.environ.get("VRM_USER")
    if not username:
        if args.user_type == 2:
            username = _prompt("Interconnection username (接口对接用户)")
        elif args.user_type == 1:
            username = _prompt("Domain username (prefer short name as in FC user list)")
        else:
            username = _prompt("Local username")

    password = args.password or os.environ.get("VRM_PASSWORD")
    if not password:
        password = getpass.getpass("Password: ")
        if not password:
            raise SystemExit("Password is required")

    return endpoint, username, password


def run_test(args: argparse.Namespace, endpoint: VrmEndpoint, username: str, password: str) -> int:
    client = VrmClient(
        endpoint=endpoint,
        api_version=args.api_version,
        verify_ssl=args.verify_ssl,
        timeout=args.timeout,
    )

    user_type_name = USER_TYPE_NAMES.get(args.user_type, str(args.user_type))
    auth_type_name = AUTH_TYPE_NAMES.get(args.auth_type, str(args.auth_type))

    _print_banner("1) Login")
    print(f"Script version: {__version__}")
    print(f"VRM: {endpoint.display}")
    if endpoint.port == 8443:
        print(f"Note: port 8443 is often the Web UI; REST API is usually {REST_API_PORT}")
    print(f"TLS verify: {'on' if args.verify_ssl else 'off (self-signed OK)'}")
    print(
        f"User: {username}  "
        f"(userType={args.user_type}/{user_type_name}, "
        f"authType={args.auth_type}/{auth_type_name}, "
        f"apiVersion={args.api_version})"
    )

    login = client.login_with_fallback(
        username,
        password,
        user_type=args.user_type,
        auth_type=args.auth_type,
        encrypt_algorithm=args.encrypt_algorithm,
        diagnose=args.diagnose,
        verbose=args.verbose,
    )

    if not login.ok:
        print("LOGIN: FAILED")
        print(f"  HTTP status: {login.http_status}")
        print(f"  Error code: {login.error_code}")
        print(f"  Error: {login.error}")
        if login.attempted:
            print("  Attempts:")
            for a in login.attempted:
                print(f"    - {a}")
        if login.error_code == "10100103":
            print()
            print(HINT_10100103)
        elif login.error_code == "10100119":
            print()
            print(HINT_10100119)
        elif login.error_code == "10000002" or login.http_status == 401:
            print()
            print(HINT_10000002)
            if endpoint.port == 8443:
                alt = f"{endpoint.scheme}://{endpoint.host}:{REST_API_PORT}"
                print(f"\nSuggested retry URL: {alt}")
        return 1

    print("LOGIN: SUCCESS")
    print(f"  HTTP status: {login.http_status}")
    print(
        f"  Auth used: userType={login.user_type}/{USER_TYPE_NAMES.get(login.user_type or -1, '?')} "
        f"authType={login.auth_type}/{AUTH_TYPE_NAMES.get(login.auth_type or -1, '?')}"
    )
    if login.token and len(login.token) > 28:
        print(f"  Token: {login.token[:16]}...{login.token[-8:]}")
    else:
        print(f"  Token: {login.token}")
    if login.body:
        print(f"  userId: {login.body.get('userId')}")
        print(f"  userName: {login.body.get('userName')}")
        print(f"  roleList: {login.body.get('roleList')}")
        print(f"  validity_ms: {login.body.get('validity')}")

    exit_code = 0
    try:
        _print_banner("2) List sites")
        sites = client.list_sites()
        print(f"Sites found: {len(sites)}")
        for site in sites:
            print(
                f"  - name={site.get('name')}  uri={site.get('uri')}  "
                f"status={site.get('status')}  isSelf={site.get('isSelf')}"
            )

        if not sites:
            print("LIST VMs: SKIPPED (no sites)")
            exit_code = 2
        else:
            _print_banner("3) List all VMs")
            grand_total = 0
            all_vms: list[dict[str, Any]] = []
            for site in sites:
                site_uri = site.get("uri")
                if not site_uri:
                    urn = site.get("urn") or ""
                    parts = urn.split(":")
                    site_uri = f"/service/sites/{parts[-1]}" if parts else None
                if not site_uri:
                    print(f"  Skipping site without uri: {site}")
                    continue

                vms = client.list_vms_for_site(
                    site_uri,
                    include_templates=args.include_templates,
                    detail=args.detail,
                )
                grand_total += len(vms)
                all_vms.extend(vms)
                print(f"\nSite {site.get('name')} ({site_uri}): {len(vms)} VM(s)")
                for vm in vms:
                    print(
                        f"  - {vm.get('name')}  status={vm.get('status')}  "
                        f"urn={vm.get('urn')}  location={vm.get('locationName') or vm.get('location')}"
                    )

            print()
            print(f"LIST VMs: SUCCESS — total {grand_total} VM(s)")
            if args.json_out:
                payload = {
                    "script_version": __version__,
                    "login": True,
                    "vrm": endpoint.display,
                    "sites": sites,
                    "vm_count": grand_total,
                    "vms": [
                        {
                            "name": vm.get("name"),
                            "status": vm.get("status"),
                            "urn": vm.get("urn"),
                            "uri": vm.get("uri"),
                        }
                        for vm in all_vms
                    ],
                }
                with open(args.json_out, "w", encoding="utf-8") as f:
                    json.dump(payload, f, indent=2)
                print(f"Wrote summary: {args.json_out}")

    except (ConnectionError, RuntimeError) as e:
        print(f"ERROR after login: {e}")
        exit_code = 3
    finally:
        _print_banner("4) Logout")
        if client.logout():
            print("LOGOUT: SUCCESS")
        else:
            print("LOGOUT: FAILED (ignored)")

    return exit_code


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Test FusionCompute VRM login and VM list APIs (domain user, self-signed TLS)",
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {__version__} ({__api_doc__})",
    )
    p.add_argument(
        "--url",
        default=None,
        help="VRM base URL, e.g. https://vrm.example.com:8443 (prompted if omitted)",
    )
    p.add_argument(
        "--port",
        type=int,
        default=int(os.environ.get("VRM_PORT", DEFAULT_PORT)),
        help=f"Default port when URL has none (default {DEFAULT_PORT})",
    )
    p.add_argument("--user", default=None, help="Domain username (prompted if omitted)")
    p.add_argument(
        "--password",
        default=None,
        help="Password (prompted if omitted; prefer prompt/env over CLI)",
    )
    p.add_argument(
        "--api-version",
        default=os.environ.get("VRM_API_VERSION", DEFAULT_API_VERSION),
        help="Accept version= (default 8.1 for FC 8.1+)",
    )
    p.add_argument(
        "--user-type",
        type=int,
        default=int(os.environ.get("VRM_USER_TYPE", str(DEFAULT_USER_TYPE))),
        help="X-Auth-UserType: 0=local, 1=domain (default), 2=interconnection",
    )
    p.add_argument(
        "--auth-type",
        type=int,
        default=int(os.environ.get("VRM_AUTH_TYPE", str(DEFAULT_AUTH_TYPE))),
        help="X-Auth-AuthType: 0=local auth (default), 1=cascading domain auth",
    )
    p.add_argument(
        "--encrypt-algorithm",
        type=int,
        default=0,
        choices=(0, 1),
        help="X-ENCRYPT-ALGORITHM: 0=SHA-256 (default), 1=plaintext",
    )
    p.add_argument(
        "--diagnose",
        action="store_true",
        help="On login failure, retry common userType/authType combinations",
    )
    p.add_argument("--verbose", action="store_true", help="Print login request details (password redacted)")
    p.add_argument("--include-templates", action="store_true", help="Also list templates")
    p.add_argument("--detail", type=int, default=0, help="VM list detail level (default 0)")
    p.add_argument(
        "--verify-ssl",
        action="store_true",
        help="Verify TLS certificates (default: off for self-signed VRM certs)",
    )
    p.add_argument("--timeout", type=float, default=30.0)
    p.add_argument("--json-out", help="Optional path to write a JSON summary")
    return p


def main() -> int:
    args = build_parser().parse_args()
    try:
        endpoint, username, password = prompt_credentials(args)
        return run_test(args, endpoint, username, password)
    except ValueError as e:
        print(f"Invalid URL: {e}", file=sys.stderr)
        return 2
    except ConnectionError as e:
        print(f"LOGIN: FAILED (connection)\n  {e}")
        return 1
    except KeyboardInterrupt:
        print("\nInterrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
